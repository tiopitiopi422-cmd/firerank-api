# FireRank API V4.2 — EXEMPLO. NUNCA coloque valores reais neste arquivo versionado.

NODE_ENV=production

# Railway fornece PORT automaticamente. Não defina manualmente salvo necessidade específica.
# PORT=10000

# Opcional no Railway: se vazio, o backend usa RAILWAY_PUBLIC_DOMAIN quando houver domínio público.
APP_BASE_URL=
CORS_ALLOWED_ORIGINS=

# Firebase
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# Alternativa ao BASE64 (não recomendado para copiar em arquivos): FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=

# Segurança
MEDIA_TOKEN_SECRET=
INTERNAL_MAINTENANCE_SECRET=
REQUIRE_APP_CHECK=false
ENFORCE_GOOGLE_PLAY_BILLING=false

# Mercado Pago
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Opcional. Se vazio, usa APP_BASE_URL/api/mercadopago/webhook
MP_WEBHOOK_URL=
# Alias aceito pelo backend:
# MERCADO_PAGO_WEBHOOK_URL=

# URLs de retorno — opcionais
PAYMENT_SUCCESS_URL=
PAYMENT_PENDING_URL=
PAYMENT_FAILURE_URL=

# E-mail / recuperação de senha
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=FireRank
MAIL_FROM_EMAIL=
PASSWORD_RESET_URL=

# Catálogo de boost opcional em JSON. Preferir configuração no Firebase quando possível.
BOOST_CATALOG_JSON=
